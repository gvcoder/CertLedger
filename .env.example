# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=certledger_super_secure_jwt_secret_key_2026

# Google Gemini AI API Key (Optional - Fallback Mock Generator Included)
GEMINI_API_KEY=your_gemini_api_key_here

# Hyperledger Fabric Gateway Configuration
FABRIC_MODE=EMULATOR  # EMULATOR or FABRIC_NETWORK
FABRIC_CONNECTION_PROFILE_PATH=./config/connection-org1.json
FABRIC_CHANNEL_NAME=certchannel
FABRIC_CHAINCODE_NAME=certledger
FABRIC_MSP_ID=Org1MSP

# AWS / External Host URL for Public Verification QR Codes
PUBLIC_BASE_URL=http://localhost:3000
